{
  "name": "@harryzhz/dsh-external-agents",
  "version": "0.4.2",
  "description": "Plug-in external CLI Agent runtimes (Codex, Antigravity, Claude Code, TRAE CLI) for DeepSeek Harness (Desktop & Web)",
  "license": "MIT",
  "homepage": "https://github.com/harryzhz/dsh-external-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryzhz/dsh-external-agents.git"
  },
  "bugs": {
    "url": "https://github.com/harryzhz/dsh-external-agents/issues"
  },
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "codex",
    "antigravity",
    "claude-code",
    "trae",
    "acp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm -r --stream build && node scripts/prepare.mjs",
    "build:bundle": "node scripts/prepare.mjs",
    "pack:bundle": "node scripts/pack.mjs",
    "prepare": "node scripts/prepare.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "typecheck": "pnpm -r --stream typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r --stream clean && node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
